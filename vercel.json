{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": "(?i)(GPTBot|ChatGPT-User|OAI-SearchBot|CCBot|ClaudeBot|Claude-SearchBot|Claude-Web|anthropic-ai|Bytespider|AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|Amazonbot|DataForSeoBot|BLEXBot|SeekportBot|serpstatbot|SEOkicks|Barkrowler|ZoominfoBot|ImagesiftBot|TikTokSpider|Diffbot|meta-externalagent|PerplexityBot|YouBot|Cohere-ai|AI2Bot|Applebot-Extended|magpie-crawler)"
          }
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ],
  "functions": {
    "src/app/api/cron/garde-weekend/route.ts": {
      "memory": 512,
      "maxDuration": 60
    },
    "src/app/api/cron/ai/route.ts": {
      "memory": 512,
      "maxDuration": 120
    },
    "src/app/api/cron/daily/route.ts": {
      "memory": 512,
      "maxDuration": 60
    },
    "src/app/api/cron/aggregate/route.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "src/app/api/cron/facebook/route.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "src/app/api/cron/te-ito-rau/route.ts": {
      "memory": 1024,
      "maxDuration": 120
    },
    "src/app/api/cron/weekly-recap/route.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "src/app/api/cron/weekly-newsletter/route.ts": {
      "memory": 512,
      "maxDuration": 300
    },
    "src/app/api/cron/discover-weekend-events/route.ts": {
      "memory": 512,
      "maxDuration": 300
    }
  }
}
